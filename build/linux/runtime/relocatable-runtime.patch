+static void addRuntimePathToSandbox(Vector<CString>& args, const String& path)
+{
+    if (path.isEmpty() || !path.startsWith('/'))
+        return;
+
+    // The sandbox starts from an empty root. Create every parent directory of the
+    // path first, because the runtime may live below a directory the sandbox does
+    // not provide by itself, such as the temporary mount point of an AppImage.
+    auto components = path.split('/');
+    if (components.size() < 2)
+        return;
+
+    StringBuilder parent;
+    for (size_t i = 0; i + 1 < components.size(); ++i) {
+        if (components[i].isEmpty())
+            continue;
+        parent.append('/');
+        parent.append(components[i]);
+        args.appendVector(Vector<CString>({ "--dir", parent.toString().utf8() }));
+    }
+
+    // bubblewrap resolves bind sources against the original root, so the directory
+    // is reachable even when the sandbox replaced its mount point with a tmpfs.
+    args.appendVector(Vector<CString>({ "--ro-bind-try", path.utf8(), path.utf8() }));
+}
