+namespace WebKit {
+
+// Paths that are derived from the WebKit library that is actually loaded at
+// runtime instead of the install prefix recorded at build time. A WebKit runtime
+// shipped next to the application (for example inside an AppImage) can therefore
+// locate its own helper processes, injected bundle, data files and sandbox
+// helpers without relying on absolute paths from the machine that built it.
+//
+// Every function returns an empty string when the loaded library does not
+// provide the corresponding directory, so a regular system installation keeps
+// using the compiled-in prefix unchanged.
+
+// <libdir>/webkitgtk-6.0, the directory holding the auxiliary processes.
+const String& loadedWebKitRuntimeDirectory();
+
+// <libdir>, the directory holding libwebkitgtk and libjavascriptcoregtk.
+const String& loadedWebKitLibraryDirectory();
+
+// <prefix>/share, used when the runtime is bound into the sandbox.
+const String& loadedWebKitDataDirectory();
+
+// Resolves a sandbox helper: the system executable is preferred so that
+// distribution security policy attached to that path keeps applying, and a copy
+// shipped with the runtime is used when the system does not provide one.
+const char* sandboxHelperExecutable(const char* executableName, const char* systemPath);
+
+} // namespace WebKit
