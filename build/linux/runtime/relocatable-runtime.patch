+static const CString& runtimeInjectedBundleDirectory()
+{
+    // The injected bundle shipped with the WebKit library loaded by this process,
+    // so that a runtime next to the application finds its own bundle instead of
+    // the absolute path recorded when WebKit was built.
+    static const CString directory = [] {
+        const String& runtimeDirectory = loadedWebKitRuntimeDirectory();
+        if (runtimeDirectory.isEmpty())
+            return CString();
+
+        auto bundleDirectory = FileSystem::pathByAppendingComponent(runtimeDirectory, String::fromLatin1("injected-bundle"));
+        CString path = bundleDirectory.utf8();
+        if (!path.data() || !g_file_test(path.data(), G_FILE_TEST_IS_DIR))
+            return CString();
+        return path;
+    }();
+    return directory;
+}
+
 static const char* injectedBundleDirectory()
 {
     const char* bundleDirectory = g_getenv("WEBKIT_INJECTED_BUNDLE_PATH");
     if (bundleDirectory && g_file_test(bundleDirectory, G_FILE_TEST_IS_DIR))
         return bundleDirectory;
 
+    const CString& runtimeDirectory = runtimeInjectedBundleDirectory();
+    if (!runtimeDirectory.isNull())
+        return runtimeDirectory.data();
+
     static const char* injectedBundlePath = PKGLIBDIR G_DIR_SEPARATOR_S "injected-bundle" G_DIR_SEPARATOR_S;
     return injectedBundlePath;
 }
