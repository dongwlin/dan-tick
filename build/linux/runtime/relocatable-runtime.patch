+static String libraryDirectoryFromAddress(const void* address)
+{
+    Dl_info info;
+    if (!dladdr(address, &info))
+        return { };
+    if (!info.dli_fname || !info.dli_fname[0])
+        return { };
+
+    // The loader reports the path it used, which may contain symbolic links or a
+    // relative LD_LIBRARY_PATH entry. Canonicalize it before deriving paths from
+    // it, so the result stays usable from other processes and inside the sandbox.
+    auto libraryPath = FileSystem::realPath(FileSystem::stringFromFileSystemRepresentation(info.dli_fname));
+    if (libraryPath.isEmpty())
+        return { };
+    return FileSystem::parentPath(libraryPath);
+}
+
+static const String& libraryDirectoryOfLoadedWebKit()
+{
+    static const String directory = libraryDirectoryFromAddress(reinterpret_cast<const void*>(reinterpret_cast<uintptr_t>(&libraryDirectoryOfLoadedWebKit)));
+    return directory;
+}
+
+const String& loadedWebKitLibraryDirectory()
+{
+    return libraryDirectoryOfLoadedWebKit();
+}
+
+const String& loadedWebKitRuntimeDirectory()
+{
+    static const String directory = [] {
+        auto libraryDirectory = libraryDirectoryOfLoadedWebKit();
+        if (libraryDirectory.isEmpty())
+            return String { };
+
+        auto runtimeDirectory = FileSystem::pathByAppendingComponent(libraryDirectory, String::fromLatin1("webkitgtk-6.0"));
+        CString path = runtimeDirectory.utf8();
+        if (!path.data() || !g_file_test(path.data(), G_FILE_TEST_IS_DIR))
+            return String { };
+        return runtimeDirectory;
+    }();
+    return directory;
+}
+
+const String& loadedWebKitDataDirectory()
+{
+    static const String directory = [] {
+        auto libraryDirectory = libraryDirectoryOfLoadedWebKit();
+        if (libraryDirectory.isEmpty())
+            return String { };
+
+        auto dataDirectory = FileSystem::realPath(FileSystem::pathByAppendingComponent(FileSystem::parentPath(libraryDirectory), String::fromLatin1("share")));
+        if (dataDirectory.isEmpty())
+            return String { };
+        return dataDirectory;
+    }();
+    return directory;
+}
+
+const char* sandboxHelperExecutable(const char* executableName, const char* systemPath)
+{
+    if (systemPath && FileSystem::fileExists(FileSystem::stringFromFileSystemRepresentation(systemPath)))
+        return systemPath;
+
+    static NeverDestroyed<HashMap<String, CString>> executables;
+    auto& cache = executables.get();
+    auto addResult = cache.ensure(String::fromLatin1(executableName), [&] {
+        auto runtimeDirectory = loadedWebKitRuntimeDirectory();
+        if (runtimeDirectory.isEmpty())
+            return CString();
+
+        auto executable = FileSystem::pathByAppendingComponent(runtimeDirectory, String::fromLatin1(executableName));
+        if (!FileSystem::fileExists(executable))
+            return CString();
+        return executable.utf8();
+    });
+
+    if (addResult.iterator->value.isNull())
+        return systemPath;
+    return addResult.iterator->value.data();
+}
