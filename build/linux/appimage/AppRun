#!/usr/bin/env bash
# Start the application with the distribution's matching GTK4/WebKitGTK stack.
set -euo pipefail

# Resolve the entrypoint when an extracted AppDir is invoked through a symbolic
# link or from an unrelated working directory.
app_dir=$(dirname -- "$(readlink -f -- "$0")")
binary="$app_dir/usr/bin/dan-tick"

runtime_error() {
  local message=$1
  local requirements='dan-tick 需要系统提供 GTK4（4.14 或更新）和 WebKitGTK 6.0 运行库。

Ubuntu / Debian：
  sudo apt install libgtk-4-1 libwebkitgtk-6.0-4 glib-networking ca-certificates

Fedora：
  sudo dnf install gtk4 webkitgtk6.0 glib-networking ca-certificates

适配目标：Ubuntu 26.04、Debian 13、Fedora 44。
需要 glibc 2.39 或更新版本；旧系统或缺失版本符号时，请升级系统。'
  printf '%s\n\n%s\n' "$requirements" "$message" >&2
  # A double-clicked AppImage often has no terminal. Use an optional system
  # dialog, without introducing another mandatory runtime dependency.
  if command -v zenity >/dev/null 2>&1 && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    zenity --error --title='dan-tick 启动失败' --text="$requirements

$message" 2>/dev/null || true
  fi
  exit 1
}

[[ -x $binary ]] || runtime_error '安装包不完整：缺少可执行的 usr/bin/dan-tick。请重新下载 AppImage。'
command -v ldd >/dev/null 2>&1 || runtime_error '找不到系统 ldd 命令，无法检查运行环境。'
if ! dependencies=$(LC_ALL=C ldd -r "$binary" 2>&1); then
  runtime_error "$dependencies"
fi
if [[ $dependencies == *'not found'* || $dependencies == *'undefined symbol'* ]]; then
  runtime_error "$dependencies"
fi

# Leave library, helper, resource and sandbox selection to the system runtime.
exec "$binary" "$@"
