{
  "name": "dan-tick-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.28.4"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc --noEmit && tsc --project tsconfig.node.json && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && tsc --project tsconfig.node.json && vite build --mode production",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.25",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  }
}
